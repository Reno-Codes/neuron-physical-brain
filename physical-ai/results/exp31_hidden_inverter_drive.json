  "hypotheses": [
    {
      "id": "H1",
      "title": "finite output current drive",
      "verdict": "not supported for OPA1656; supported for teaching miller",
      "evidence": "OPA isolated analog-passes at the worst hidden Vin/load, so it can deliver the required current. Miller isolated cannot. See Imax sweep for the behavioral current floor."
    },
    {
      "id": "H2",
      "title": "output swing limitation",
      "verdict": "not supported for OPA1656; supported for teaching miller",
      "evidence": "OPA rails +/-15 V cover hy_max=2.61 V. Miller rails +/-2.5 V sit on that edge and the isolated invert clips/collapses."
    },
    {
      "id": "H3",
      "title": "finite closed-loop gain",
      "verdict": "rejected as the 32-OPA mechanism",
      "evidence": "A_eff = |Vout|/|Vmid| is misleading when Vmid is a constant 498 uV pedestal. Behavioral 32-hidden A=5e3 MAE=6.79e-4 (pass), not 2.64e-3."
    },
    {
      "id": "H4",
      "title": "effective offset accumulation",
      "verdict": "supported",
      "evidence": "32-OPA v(mid) MAE median=4.9811e-04. Behavioral Vos=500 uV MAE=2.6674e-03; model Vos=8.75 uV MAE=5.0880e-04. One insertion passes because a single ~1 mV invert error is averaged away."
    },
    {
      "id": "H5",
      "title": "finite Rout / loading",
      "verdict": "contributes to A_eff; see Rout sweep",
      "evidence": "err vs Rload correlation=-1.1700e-01; err vs |I| correlation=-6.0349e-01."
    },
    {
      "id": "H6",
      "title": "supply interaction between simultaneous stages",
      "verdict": "rejected",
      "evidence": "32 independent +/-15 V supplies MAE=2.6377e-03 vs shared MAE=2.6377e-03. Independent supplies are not a physical solution unless a realistic distribution is demonstrated; they are a mechanism test."
    },
    {
      "id": "H7",
      "title": "macromodel convergence artifact",
      "verdict": "rejected",
      "evidence": "failed=False conv_warn=0 spice_s=126.47."
    },
    {
      "id": "H8",
      "title": "shared reference / grounding interaction",
      "verdict": "not separately supported",
      "evidence": "Analog ground remains node 0. Independent supplies (H6) did not remove the analog fail if they match shared-supply MAE. No extra analog-ground split was invented."
