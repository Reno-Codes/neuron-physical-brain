Rn1f n1lin n1p 33333.3333333333

* MOS TIA + optional MOS servo. IN- sense at n1p (sum). OUT = n1lin.
* TIA subckt=miller_tia topology=miller
* Vn1ib is a 0 V ammeter: i(Vn1ib) = current from sum into MOS IN-.
Vn1ib n1p n1inn DC 0
Vosinj n1osp n1srv DC 0
Xn1tia n1osp n1inn n1lin vdd vss miller_tia MD=2 MT=2 MO=4 CC=2e-12 IBIAS=4e-05 DW=0.00185 L1=1.4u
* MOS miller leaky integrator servo: tau~Rin*C=5e-05 s
Rn1si n1p n1sint 50000
Cn1int n1sint n1srv 1e-09
Rn1leak n1sint n1srv 100000000
Xn1srv 0 n1sint n1srvo vdd vss miller_tia MD=2 MT=2 MO=4 CC=2e-12 IBIAS=2e-05 DW=0.001487
.ic v(n1srv)=0

* Exp 27 MOS AZ hold. Sample until t=0.0002s, then hold V(n1srv).
* NCH pass transistor from the BSIM3 teaching card. Not an ideal SW.
Vazclk n1clk 0 PULSE(2.5 -2.5 0.0002 10n 10n 1 2)
Xn1azsw n1srvo n1clk n1srv vss NCH W=5u L=1.4u m=4
Cn1az n1srv 0 10n
.control
set numdgt=15
set wr_singlescale
tran 8.5e-07 0.00034
wrdata c3d_0p0001.dat v(n1lin) v(n1p) v(n1srv) i(Vdd)
print v(n1lin)
print v(n1p)
print v(n1srv)
print i(Vdd)
.endc

.end
