Vh4p h4p 0 DC 0
Vh4n h4n 0 DC 0
Fh4p 0 h4d Vh4p 1
Fh4n h4d 0 Vh4n 1
Vh4d h4d 0 DC 0
Hh4 h4lin 0 Vh4d 2162.86246673884
Bh4 h4amp 0 V = max(-15, min(15, 100000 * v(h4lin, h4y)))
Dh4 h4amp h4y Dsi
RLh4 h4y 0 10000
Eh4 h4buf 0 h4y 0 1

* --- neuron o1 ---
* separate bias path: I_b_injected = k * Vref * G_B * |b|, k=G_W/G_B=0.0122979600845127
* so V_b = I_b_injected / G_W = |b|  (math bias unchanged)
* o1 input 1 w=+0.601889648539537 w+  G = 0.000278283828859014 S  R = 3593.45350428762 Ohm
Ro1p1 h1buf o1p 3593.45350428762
* o1 input 2 w=+0.347315954504283 w+  G = 0.000160581618038786 S  R = 6227.36283401047 Ohm
Ro1p2 h2buf o1p 6227.36283401047
* o1 input 3 w=+0.876922607606196 w+  G = 0.000405445385960402 S  R = 2466.4234311885 Ohm
Ro1p3 h3buf o1p 2466.4234311885
* o1 input 4 w=+0.929527796434486 w+  G = 0.000429767408112651 S  R = 2326.8400095567 Ohm
Ro1p4 h4buf o1p 2326.8400095567
* o1 bias=+0.0103504514823374 b+  G = 0.000389132326580817 S  R = 2569.81990878703 Ohm
Ro1bp vref o1biasp 2569.81990878703
Vo1bbp o1biasp 0 DC 0
Fo1bbp 0 o1d Vo1bbp 0.0122979600845127
Vo1p o1p 0 DC 0
Vo1n o1n 0 DC 0
Fo1p 0 o1d Vo1p 1
Fo1n o1d 0 Vo1n 1
Vo1d o1d 0 DC 0
Ho1 o1lin 0 Vo1d 2162.86246673884

.model Dsi D(Is=1e-14 N=1 Rs=1)
.control
set numdgt=15
alter Vin1 DC 0.494125531810799
alter Vin2 DC -0.229451673774848
op
print v(o1lin)
alter Vin1 DC 0.756925898000261
